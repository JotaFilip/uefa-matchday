__pycache__/
*.pyc
.DS_Store

# fixtures/ stays local only: the daily GitHub Actions job does a full scan
# (no fixtures cache on the runner); the local cache keeps re-runs instant.
fixtures/

# logo PNGs stay local; only the team_logos.json mapping is committed
logos/*
!logos/team_logos.json

# standings PNGs are not committed — the daily job uploads them to the
# per-season GitHub Release instead
standings/**/*.png